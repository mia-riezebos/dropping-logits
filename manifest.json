{
	"manifest_version": 3,
	"name": "Dropping Logits",
	"description": "Replaces AI marketing speak with toilet humour. Launching models? Dropping logs.",
	"permissions": ["storage"],
	"minimum_chrome_version": "125",
	"browser_specific_settings": {
		"gecko": {
			"id": "dropping-logits@mia-riezebos",
			"strict_min_version": "140.0",
			"data_collection_permissions": { "required": ["none"] }
		},
		"gecko_android": { "strict_min_version": "142.0" }
	},
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"action": {
		"default_title": "Toggle Dropping Logits",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png"
		}
	},
	"background": {
		"service_worker": "background.js",
		"scripts": ["background.js"]
	},
	"content_scripts": [
		{
			"matches": ["<all_urls>"],
			"js": ["content.js"],
			"run_at": "document_idle",
			"all_frames": true
		}
	]
}
